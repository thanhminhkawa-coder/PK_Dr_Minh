PORT=3000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/clinic
MONGODB_URI_DIRECT=mongodb://host1:27017,host2:27017,host3:27017/clinic?replicaSet=atlas-xxxxx-shard-0&ssl=true&authSource=admin&retryWrites=true&w=majority
CORS_ORIGINS=https://your-site.netlify.app,http://localhost:8888,http://127.0.0.1:3000

# Đăng nhập (bắt buộc): tạo bằng `openssl rand -hex 32`
JWT_ACCESS_SECRET=replace-with-a-long-random-string
# Địa chỉ công khai của app, dùng cho link đặt lại mật khẩu
APP_BASE_URL=https://your-app.onrender.com
NODE_ENV=production
# Gửi email quên mật khẩu (Gmail + App Password). Bỏ trống khi dev: link sẽ in ra console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM="PK Dr. Minh <your-account@gmail.com>"
